# ============================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ============================================

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/blood_donation_emergency
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=blood_donation_emergency

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application Settings
ENV=development
PORT=8000
DEBUG=True
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Google OAuth (Optional)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/auth/google/callback

# Email Service
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@blooddonation.com
SENDER_NAME=Blood Donation Emergency

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-email@firebase.com

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Sentry (Error Tracking - Optional)
SENTRY_DSN=

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Blood Donation Emergency
VITE_APP_VERSION=1.0.0
VITE_SOCKET_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Admin (for first-time setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=blood_donation_emergency

# PostGIS Extensions
POSTGIS_VERSION=3.3